{
  "name": "astraldeep-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=scripts/model.mjs --test-coverage-include=scripts/github.mjs --test-coverage-include=scripts/sync.mjs tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "sync": "node scripts/run.mjs",
    "check": "node --check site/app.js && node --check site/theme.js && node --check scripts/run.mjs && node --check scripts/build.mjs && node --check scripts/notify.mjs"
  }
}
